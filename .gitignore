# Raw downloaded data sources (large; not committed)
data/raw/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Results scratch (committed selectively)
results/scratch/
# resume cache + transient sweep progress logs (regenerated by the coverage scripts)
results/.generability_targets.json
results/*.progress.log

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# wandb (Phase 2, optional)
wandb/

# Phase A/B/C policy pipeline: 3D coordinate data is regeneratable from the
# tracked scripts + EX3 chain; keep parquet metadata + manifests but skip the
# large raw PDB/SDF/MSA outputs.
data/policy/structures/*/
data/policy/docking/*/cycle_*/ligand.sdf
data/policy/docking/*/cycle_*/placed.sdf
data/policy/docking/*/cycle_*/complex.pdb
data/policy/_synthetic_dry_run.pdb
data/raw/uniprot_cache/

# Derived submission artifacts (regenerate from paper/ sources)
/arxiv_submission.tar.gz
/arxiv_submission/
/submission/
